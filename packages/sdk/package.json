{
  "name": "@webmcp/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for WebMCP - Connecting Web AI agents to browser content and local network resources.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
