{
  "name": "@webmcp/adapter-express",
  "version": "0.1.0",
  "description": "Express.js Middleware Adapter for WebMCP",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun x tsc --declaration --emitDeclarationOnly --outDir ./dist",
    "check": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@thestudioxi/webmcp": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "author": "zhenximi",
  "license": "MIT"
}
