# WebMCP Agentic App - AI Model Auth Configuration

# Choose provider: gemini | openai | anthropic | mock
AI_PROVIDER=gemini

# Provider API Keys (Uncomment and set your key)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Identifier
AI_MODEL=gemini-2.5-flash

# Optional Custom Base URL (e.g. http://localhost:11434/v1 for Ollama)
# AI_BASE_URL=
