{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@thestudioxi/webmcp": ["packages/sdk/src/index.ts"],
      "@thestudioxi/webmcp-adapter-vercel-ai": ["packages/adapters/vercel-ai/src/index.ts"],
      "@thestudioxi/webmcp-adapter-express": ["packages/adapters/express/src/index.ts"],
      "@thestudioxi/webmcp-adapter-hono": ["packages/adapters/hono/src/index.ts"],
      "@thestudioxi/webmcp-adapter-nest": ["packages/adapters/nest/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "graphify-out"]
}
