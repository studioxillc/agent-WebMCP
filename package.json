{
  "name": "agent-webmcp-monorepo",
  "author": "zhenximi",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/sdk build",
    "check": "bun x tsc --noEmit",
    "test": "bun test",
    "graphify": "./scripts/graphify.sh",
    "example:agent": "bun run --cwd examples/agentic-app start",
    "example:web": "bun run --cwd examples/agentic-app dev",
    "example:next": "bun run --cwd examples/nextjs-vercel-ai dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
