{
  "name": "agent-webmcp-monorepo",
  "author": "Studio Xi LLC",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/sdk build && bun run build:adapters",
    "build:adapters": "bun run --cwd packages/adapters/vercel-ai build && bun run --cwd packages/adapters/express build && bun run --cwd packages/adapters/hono build && bun run --cwd packages/adapters/nest build",
    "check": "bun x tsc --noEmit",
    "test": "bun test",
    "graphify": "./scripts/graphify.sh",
    "example:agent": "bun run --cwd examples/agentic-app start",
    "example:web": "bun run --cwd examples/agentic-app dev",
    "example:next": "bun run --cwd examples/nextjs-vercel-ai dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "bun run build && changeset publish",
    "docs:dev": "cd docs-site && bun run dev",
    "docs:build": "cd docs-site && bun run build",
    "docs:preview": "cd docs-site && bun run preview"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
